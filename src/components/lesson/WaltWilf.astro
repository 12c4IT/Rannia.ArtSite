---
interface Props {
  walt: string[];
  wilf: string[];
  yearLevel: 11 | 12;
  durationMinutes: number;
}

const { walt, wilf, yearLevel, durationMinutes } = Astro.props;
---

<section class="wwrap">
  <div class="meta">
    <span class="chip">Year {yearLevel}</span>
    <span class="chip">{durationMinutes} min</span>
  </div>
  <div class="cols">
    <div class="col walt">
      <p class="lab">WALT · Learning intentions</p>
      <p class="sub"><em>We are learning to…</em></p>
      <ul>
        {walt.map((w) => <li>{w}</li>)}
      </ul>
    </div>
    <div class="col wilf">
      <p class="lab">WILF · Success criteria</p>
      <p class="sub"><em>What I'm looking for…</em></p>
      <ul>
        {wilf.map((w) => <li>{w}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .wwrap {
    padding: clamp(28px, 4vw, 44px) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .meta { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 22px; }
  .chip {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 5px 10px;
  }
  .cols { display: grid; grid-template-columns: 1fr; gap: 28px; }
  @media (min-width: 780px) { .cols { grid-template-columns: 1fr 1fr; gap: 44px; } }
  .col { display: flex; flex-direction: column; gap: 10px; }
  .lab { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin: 0; }
  .walt .lab { color: var(--f-cult); }
  .wilf .lab { color: var(--f-struct); }
  .sub { font-family: var(--font-display); font-size: 15.5px; color: var(--ink-2); margin: 0 0 8px; }
  .sub em { font-style: italic; }
  ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  li {
    position: relative;
    padding-left: 22px;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--ink);
  }
  li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 12px;
    height: 1px;
    background: var(--accent);
  }
</style>
