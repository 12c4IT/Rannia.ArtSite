---
interface Props {
  artist: string;
  artwork: string;
  world: string;
  audience: string;
}

const { artist, artwork, world, audience } = Astro.props;

const cells: Array<{ label: string; body: string }> = [
  { label: 'Artist', body: artist },
  { label: 'Artwork', body: artwork },
  { label: 'World', body: world },
  { label: 'Audience', body: audience },
];
---

<section class="cf">
  <p class="section-eyebrow">Conceptual Framework</p>
  <div class="grid">
    {cells.map((c) => (
      <div class="cell">
        <h3>{c.label}</h3>
        <p>{c.body}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .cf { padding: clamp(32px, 5vw, 56px) 0; }
  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 16px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  @media (min-width: 620px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 980px) { .grid { grid-template-columns: repeat(4, 1fr); } }
  .cell { background: var(--paper); padding: 24px 22px; display: flex; flex-direction: column; gap: 10px; }
  .cell h3 {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 440;
    letter-spacing: -0.005em;
    color: var(--ink);
    margin: 0;
  }
  .cell p {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
  }
</style>
