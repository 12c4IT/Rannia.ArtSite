---
interface Props {
  prompt: string;
  label?: string;
  size?: 'sm' | 'md';
}

const { prompt, label = 'Copy prompt', size = 'md' } = Astro.props;
---

<button
  class:list={['copy-prompt', { sm: size === 'sm' }]}
  type="button"
  data-prompt={prompt}
  data-copied="false"
>
  <span class="ico" aria-hidden="true">⧉</span>
  <span class="txt">{label}</span>
</button>

<style>
  .copy-prompt {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    padding: 9px 14px;
    cursor: pointer;
    transition: border-color 140ms ease, color 140ms ease;
  }
  .copy-prompt.sm { font-size: 11.5px; padding: 6px 10px; }
  .copy-prompt:hover { border-color: var(--accent); color: var(--accent); }
  .copy-prompt[data-copied="true"] { border-color: var(--accent); color: var(--accent); }
  .copy-prompt .ico { font-family: var(--font-mono); font-size: 14px; opacity: 0.7; }
  .copy-prompt[data-copied="true"] .ico::before { content: "✓ "; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-prompt').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const prompt = btn.dataset.prompt ?? '';
      try {
        await navigator.clipboard.writeText(prompt);
        btn.dataset.copied = 'true';
        const txt = btn.querySelector<HTMLSpanElement>('.txt');
        const orig = txt?.textContent ?? '';
        if (txt) txt.textContent = 'Copied';
        setTimeout(() => {
          btn.dataset.copied = 'false';
          if (txt) txt.textContent = orig;
        }, 1600);
      } catch (e) {}
    });
  });
</script>
