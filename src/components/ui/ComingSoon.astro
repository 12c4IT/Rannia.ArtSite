---
interface Props {
  eyebrow: string;
  title: string;
  blurb: string;
  waitingOn?: string;
}

const { eyebrow, title, blurb, waitingOn } = Astro.props;
---

<div class="wrap">
  <div class="head">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede">{blurb}</p>
  </div>

  <div class="callout">
    <p class="lab">Coming soon</p>
    <p>This page is under construction. {waitingOn && (<span><br />Waiting on: <b>{waitingOn}</b></span>)}</p>
    <p class="row"><a class="textlink" href="/">← Back to home</a> <a class="textlink" href="/case-studies">Browse case studies →</a></p>
  </div>
</div>

<style>
  .wrap { max-width: 900px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 28px); }
  .head { padding: clamp(48px, 8vw, 96px) 0 clamp(24px, 4vw, 48px); border-bottom: 1px solid var(--rule); }
  .eyebrow { font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin: 0 0 18px; }
  h1 { font-family: var(--font-display); font-size: var(--text-display); font-weight: 360; line-height: 1.0; letter-spacing: -0.02em; margin: 0 0 20px; max-width: 18ch; }
  .lede { font-family: var(--font-display); font-size: var(--text-lede); line-height: 1.4; color: var(--ink); max-width: 54ch; margin: 0; }

  .callout {
    margin: clamp(32px, 5vw, 56px) 0;
    padding: clamp(24px, 4vw, 36px);
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-card);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .lab { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin: 0; }
  .callout p:not(.lab) { font-size: 15px; line-height: 1.6; color: var(--ink-2); margin: 0; }
  .row { display: flex; flex-wrap: wrap; gap: 20px; padding-top: 4px; }
  .textlink { font-family: var(--font-sans); font-size: 13.5px; font-weight: 500; color: var(--accent); text-decoration: none; border-bottom: 1px solid color-mix(in oklab, var(--accent), transparent 55%); padding-bottom: 1px; }
  .textlink:hover { color: var(--ink); border-bottom-color: var(--ink); }
  b { color: var(--ink); font-weight: 500; }
</style>
