---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BowMediumBadge from './BowMediumBadge.astro';
import FrameBadge from '../case-study/FrameBadge.astro';

interface HeroImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  href: string;
  title: string;
  studentDisplayName: string;
  yearGraduated: number;
  medium: string;
  band?: number;
  shortPitch: string;
  heroImage: HeroImage;
  frames: string[];
}

const {
  href,
  title,
  studentDisplayName,
  yearGraduated,
  medium,
  band,
  shortPitch,
  heroImage,
  frames,
} = Astro.props;
---

<a class="bow-card" href={href} data-medium={medium}>
  <div class="image">
    <Image
      src={heroImage.src}
      alt={heroImage.alt}
      widths={[320, 640, 900]}
      sizes="(min-width: 980px) 33vw, (min-width: 620px) 50vw, 100vw"
    />
  </div>
  <div class="body">
    <div class="badges">
      <BowMediumBadge medium={medium} />
      {band && <span class="band">Band {band}</span>}
    </div>
    <h3>{title}</h3>
    <p class="meta">{studentDisplayName} · Graduated {yearGraduated}</p>
    <p class="pitch">{shortPitch}</p>
    {frames.length > 0 && (
      <div class="frames">
        {frames.map((f) => <FrameBadge frame={f as any} />)}
      </div>
    )}
  </div>
</a>

<style>
  .bow-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--paper);
    text-decoration: none;
    transition: border-color 140ms ease, transform 140ms ease;
  }
  .bow-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .image { aspect-ratio: 4 / 3; overflow: hidden; background: var(--paper-2); border-bottom: 1px solid var(--rule); }
  .image :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .body { padding: 18px 18px 20px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .badges { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .band {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 5px 10px;
  }
  h3 { font-family: var(--font-display); font-size: 22px; font-weight: 420; line-height: 1.15; margin: 0; color: var(--ink); }
  .meta { font-family: var(--font-display); font-style: italic; font-size: 14px; color: var(--ink-2); margin: 0; }
  .pitch { font-size: 14px; line-height: 1.55; color: var(--ink-2); margin: 0; }
  .frames { margin-top: auto; display: flex; flex-wrap: wrap; gap: 5px; padding-top: 6px; }
</style>
