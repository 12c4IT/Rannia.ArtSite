---
const nav = [
  { href: '/case-studies', label: 'Case Studies' },
  { href: '/body-of-works', label: 'Body of Works' },
  { href: '/frames', label: 'Frames' },
  { href: '/practice', label: 'Practice' },
  { href: '/command-words', label: 'Command Words' },
  { href: '/ai-tutor', label: 'AI Tutor' },
  { href: '/lessons', label: 'Lessons' },
  { href: '/glossary', label: 'Glossary' },
];
---

<header class="site-header">
  <div class="bar">
    <a href="/" class="wordmark">Visual <em>Arts</em></a>

    <details class="nav">
      <summary><span class="menu-word">Menu</span></summary>
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </details>

    <div class="tools">
      <form class="search" role="search">
        <label for="site-search" class="sr-only">Search the site</label>
        <input id="site-search" type="search" name="q" placeholder="Search…" autocomplete="off" />
      </form>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch colour theme">
        <span class="t-icon" aria-hidden="true"></span>
        <span class="t-label">Theme</span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--rule); background: var(--paper); }
  .bar {
    max-width: 1180px; margin: 0 auto; padding: 15px clamp(16px, 4vw, 28px);
    display: flex; align-items: center; gap: clamp(12px, 3vw, 28px);
  }

  .wordmark {
    font-family: var(--font-display); font-weight: 450; font-size: 21px;
    letter-spacing: -0.01em; color: var(--ink); text-decoration: none; white-space: nowrap;
  }
  .wordmark em { font-style: italic; font-weight: 400; color: var(--accent); }

  /* nav — disclosure dropdown on mobile, inline on desktop */
  .nav { position: relative; }
  .nav summary {
    list-style: none; cursor: pointer;
    font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-2); border: 1px solid var(--rule); border-radius: 999px; padding: 9px 14px;
  }
  .nav summary::-webkit-details-marker { display: none; }
  .nav summary:hover { color: var(--accent); border-color: var(--accent); }
  .nav ul {
    position: absolute; top: calc(100% + 8px); left: 0; z-index: 30;
    margin: 0; padding: 8px; list-style: none;
    background: var(--paper); border: 1px solid var(--rule); border-radius: var(--radius-card);
    box-shadow: 0 10px 28px color-mix(in oklab, var(--ink), transparent 88%);
    display: flex; flex-direction: column; gap: 2px; min-width: 210px;
  }
  .nav a {
    display: block; font-family: var(--font-sans); font-size: 14px; color: var(--ink-2);
    text-decoration: none; padding: 10px 12px; border-radius: 2px;
  }
  .nav a:hover { color: var(--accent); background: var(--paper-2); }

  .tools { margin-left: auto; display: flex; align-items: center; gap: 10px; }

  .search input {
    font-family: var(--font-sans); font-size: 13px; color: var(--ink);
    background: var(--paper-2); border: 1px solid var(--rule); border-radius: 999px;
    padding: 9px 15px; width: 168px;
  }
  .search input::placeholder { color: var(--ink-2); }
  .search input:focus-visible { border-color: var(--accent); outline: none; }

  .theme-toggle {
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-2); background: transparent; border: 1px solid var(--rule); border-radius: 999px;
    padding: 8px 13px; min-height: 38px;
  }
  .theme-toggle:hover { color: var(--accent); border-color: var(--accent); }
  .t-icon {
    width: 13px; height: 13px; border-radius: 50%; border: 1.5px solid currentColor;
    background: linear-gradient(90deg, currentColor 0 50%, transparent 50% 100%);
  }

  @media (max-width: 600px) {
    .search { display: none; }
    .theme-toggle { min-height: 44px; }
    .nav summary { padding: 12px 14px; }
  }

  /* Desktop: inline nav, no Menu button */
  @media (min-width: 900px) {
    .nav summary { display: none; }
    .nav ul {
      position: static; display: flex; flex-direction: row; gap: 26px;
      padding: 0; border: 0; background: none; box-shadow: none; min-width: 0;
    }
    .nav a { padding: 0; font-size: 14px; }
    .nav a:hover { background: none; }
  }
</style>

<script>
  // Theme toggle (no-FOUC default is set inline in <head>). Search modal arrives in Task 9.
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');
  const label = btn?.querySelector('.t-label');
  const form = document.querySelector<HTMLFormElement>('.site-header form.search');
  form?.addEventListener('submit', (e) => e.preventDefault());

  const effective = () =>
    root.getAttribute('data-theme') ||
    (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

  const sync = () => { if (label) label.textContent = effective() === 'dark' ? 'Light' : 'Dark'; };
  sync();

  btn?.addEventListener('click', () => {
    const next = effective() === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('va-theme', next); } catch (e) {}
    sync();
  });
</script>
