---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FrameBadge from '../../components/case-study/FrameBadge.astro';
import ContentAreaBadge from '../../components/case-study/ContentAreaBadge.astro';
import ConceptualFrameworkSummary from '../../components/case-study/ConceptualFrameworkSummary.astro';
import ArtworkBlock from '../../components/case-study/ArtworkBlock.astro';
import ThemesTechniques from '../../components/case-study/ThemesTechniques.astro';
import SampleQuestionsAndAnswers from '../../components/case-study/SampleQuestionsAndAnswers.astro';
import LastReviewed from '../../components/ui/LastReviewed.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';

// Review environment — every entry gets a page. See note in case-studies/index.astro.
export const getStaticPaths = (async () => {
  const entries = await getCollection('case-studies');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const dates = `${data.artist.birthYear}${data.artist.deathYear ? `–${data.artist.deathYear}` : ''} · ${data.artist.nationality}`;

const [artwork1, artwork2] = data.artworks;
---

<BaseLayout title={`${data.artist.name} — Visual Arts`} description={data.shortPitch}>
  <article>
    <!-- Hero -->
    <header class="hero">
      <div class="wrap">
        <p class="eyebrow">Case study · <FrameBadge frame={data.primaryFrame} primary /></p>
        <h1>
          {data.artist.name.split(' ').slice(0, -1).join(' ')}
          <em>{data.artist.name.split(' ').slice(-1)[0]}</em>
        </h1>
        <p class="dates">{dates}</p>
        <p class="pitch">{data.shortPitch}</p>
        <div class="areas">
          {data.contentAreas.map((a) => <ContentAreaBadge area={a} />)}
        </div>
      </div>
    </header>

    <div class="wrap">
      <!-- Conceptual Framework -->
      <ConceptualFrameworkSummary
        artist={data.conceptualFramework.artist}
        artwork={data.conceptualFramework.artwork}
        world={data.conceptualFramework.world}
        audience={data.conceptualFramework.audience}
      />

      <!-- Themes & Techniques -->
      <ThemesTechniques themes={data.themes} techniques={data.techniques} />

      <!-- Artist practice — long-form MDX body -->
      <section class="prose">
        <p class="section-eyebrow">Artist practice</p>
        <Content />
      </section>

      <!-- Artworks -->
      <ArtworkBlock
        image={artwork1.image}
        annotations={artwork1.annotations}
        frames={artwork1.frames}
        notes={artwork1.notes}
        number={1}
      />
      <ArtworkBlock
        image={artwork2.image}
        annotations={artwork2.annotations}
        frames={artwork2.frames}
        notes={artwork2.notes}
        number={2}
      />

      <!-- Sample Q&A -->
      <SampleQuestionsAndAnswers items={data.sampleQuestionsAndAnswers} />

      <!-- Sources -->
      <section class="sources">
        <p class="section-eyebrow">Sources</p>
        <ol>
          {data.sources.map((s, i) => (
            <li id={`source-${s.id}`}>
              <span class="n">[{i + 1}]</span>
              <div class="source">
                <span class="cite-line">
                  <b>{s.author}</b>, <em>{s.title}</em>
                  {s.publisher ? `, ${s.publisher}` : ''}
                  {s.year ? ` (${s.year})` : ''}
                  {s.pages ? `, ${s.pages}` : ''}
                  {s.url && <> · <a href={s.url}>link</a></>}
                </span>
                {s.notes && <span class="notes">{s.notes}</span>}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <LastReviewed date={data.lastReviewed} reviewedBy={data.reviewedBy} />
    </div>
  </article>

  <StatusBadge status={data.status} />
</BaseLayout>

<style>
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 28px); }

  .hero { padding: clamp(48px, 8vw, 96px) 0 clamp(24px, 4vw, 48px); border-bottom: 1px solid var(--rule); }
  .hero .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 20px;
  }
  h1 {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 360;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }
  h1 em { color: var(--accent); font-style: italic; font-weight: 360; }
  .dates {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 18px;
    color: var(--ink-2);
    margin: 0 0 20px;
  }
  .pitch {
    font-family: var(--font-display);
    font-weight: 380;
    font-size: var(--text-lede);
    line-height: 1.4;
    color: var(--ink);
    margin: 0 0 22px;
    max-width: 54ch;
  }
  .areas { display: flex; flex-wrap: wrap; gap: 6px; }

  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 20px;
  }

  .prose {
    padding: clamp(32px, 5vw, 56px) 0;
    border-top: 1px solid var(--rule);
    max-width: 68ch;
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 440;
    margin: 32px 0 12px;
  }
  .prose :global(h3) {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 440;
    margin: 28px 0 10px;
  }
  .prose :global(p) {
    font-size: var(--text-body);
    line-height: 1.7;
    color: var(--ink);
    margin: 0 0 18px;
  }
  .prose :global(p:last-child) { margin-bottom: 0; }
  .prose :global(a) { color: var(--accent); }

  .sources {
    padding: clamp(32px, 5vw, 56px) 0;
    border-top: 1px solid var(--rule);
  }
  .sources ol { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .sources li { display: flex; gap: 12px; scroll-margin-top: 20px; }
  .sources .n {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    padding-top: 2px;
    flex: 0 0 34px;
  }
  .sources .source { display: flex; flex-direction: column; gap: 4px; }
  .sources .cite-line { font-size: 14.5px; line-height: 1.55; color: var(--ink); }
  .sources em { font-style: italic; }
  .sources .notes { font-size: 13.5px; color: var(--ink-2); font-style: italic; }
  .sources a { color: var(--accent); }
</style>
