---
import BaseLayout from '../layouts/BaseLayout.astro';
import DiffViewer from '../components/edit/DiffViewer.astro';

// The /edit page is a static Astro shell. All behaviour is client-side —
// the page fetches to the Cloudflare Worker on submit, consumes an SSE
// stream of progress + diff events, renders them into <DiffViewer/>, and
// polls Netlify's Deploys API for the branch preview URL.
//
// The Worker URL is a build-time constant (baked into the HTML at build).
// If we ever host the Worker on a custom subdomain, swap it here.
//
// Cloudflare Access sits in front of the Worker at the DNS layer. First
// visit → Access redirects to email-OTP; subsequent requests carry the
// Access cookie automatically because the Worker is on the same
// registrable domain.

const WORKER_URL = import.meta.env.PUBLIC_EDIT_WORKER_URL ?? 'https://REPLACE-ME.workers.dev';
const NETLIFY_SITE_ID = import.meta.env.PUBLIC_NETLIFY_SITE_ID ?? '';
---

<BaseLayout title="Edit — Visual Arts" description="Content editor for the site owner.">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow">Site editor</p>
      <h1>What would you like to <em>change</em>?</h1>
      <p class="lede">Type a plain-English request. I'll draft the change and show you what I'm proposing — you approve before anything goes live.</p>
    </header>

    <form id="edit-form" class="form" enctype="multipart/form-data">
      <label class="field">
        <span class="lab">Your request</span>
        <textarea
          id="prompt"
          name="prompt"
          rows="6"
          placeholder="e.g. On the About page, change the tagline from &quot;a study resource&quot; to &quot;a study & practice resource&quot;."
          required
          maxlength="4096"
        ></textarea>
      </label>

      <div class="field">
        <span class="lab">Images (optional)</span>
        <p class="hint">Drop image files here to include them in the edit. Max 4 files, 5MB each. PNG, JPEG, WebP only.</p>
        <div id="drop-zone" class="drop-zone">
          <input id="file-input" type="file" accept="image/png,image/jpeg,image/webp" multiple hidden />
          <p class="drop-hint" id="drop-hint">Click or drop files</p>
          <ul id="file-list" class="file-list"></ul>
        </div>
      </div>

      <div class="controls">
        <button id="submit-btn" type="submit" class="submit">Draft the change</button>
        <p id="status" class="status" role="status" aria-live="polite"></p>
      </div>
    </form>

    <section id="progress" hidden class="progress">
      <p class="lab">Drafting…</p>
      <pre id="progress-text" class="progress-text"></pre>
    </section>

    <DiffViewer />

    <section id="preview-block" hidden class="preview-block">
      <p class="lab">Deploy preview</p>
      <p id="preview-status" class="preview-status">Building on Netlify — usually about 90 seconds.</p>
      <a id="preview-link" href="#" target="_blank" rel="noopener noreferrer" hidden>Open preview →</a>
      <p class="next-steps">
        When it looks right, ask Joe to merge the branch. Nothing goes to the live site until he does.
        <br />
        Branch: <code id="branch-name"></code>
      </p>
    </section>

    <section id="error-block" hidden class="error-block">
      <p class="lab">Something went wrong</p>
      <p id="error-detail"></p>
      <button type="button" class="submit" onclick="location.reload()">Start over</button>
    </section>
  </div>
</BaseLayout>

<style>
  .wrap { max-width: 900px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 28px) clamp(48px, 8vw, 96px); }

  .head { padding: clamp(48px, 8vw, 96px) 0 clamp(24px, 4vw, 40px); border-bottom: 1px solid var(--rule); }
  .eyebrow { font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin: 0 0 18px; }
  h1 { font-family: var(--font-display); font-size: var(--text-display); font-weight: 360; line-height: 1.02; letter-spacing: -0.02em; margin: 0 0 20px; max-width: 22ch; }
  h1 em { color: var(--accent); font-style: italic; font-weight: 340; }
  .lede { font-family: var(--font-display); font-size: var(--text-lede); line-height: 1.4; color: var(--ink); max-width: 60ch; margin: 0; }

  .form { padding: clamp(28px, 4vw, 40px) 0; display: flex; flex-direction: column; gap: 24px; }
  .field { display: flex; flex-direction: column; gap: 8px; }
  .lab { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .hint { font-size: 13px; color: var(--ink-2); margin: 0; }

  textarea {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    padding: 14px 16px;
    resize: vertical;
    min-height: 140px;
  }
  textarea:focus-visible { border-color: var(--accent); outline: none; }

  .drop-zone {
    border: 1px dashed var(--rule);
    border-radius: var(--radius-card);
    padding: 22px;
    background: var(--paper-2);
    cursor: pointer;
    transition: border-color 140ms ease, background 140ms ease;
  }
  .drop-zone:hover { border-color: var(--accent); }
  .drop-zone[data-dragover="true"] { border-color: var(--accent); background: color-mix(in oklab, var(--accent), transparent 92%); }
  .drop-hint { font-family: var(--font-mono); font-size: 12px; color: var(--ink-2); margin: 0; text-align: center; }
  .file-list { list-style: none; padding: 0; margin: 12px 0 0; display: flex; flex-direction: column; gap: 6px; }
  .file-list li { display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 12px; color: var(--ink); }
  .file-list .remove {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 3px 8px;
    color: var(--ink-2);
    cursor: pointer;
  }
  .file-list .remove:hover { color: var(--accent); border-color: var(--accent); }

  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 8px; }
  .submit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--on-accent);
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius-card);
    padding: 11px 18px;
    cursor: pointer;
  }
  .submit:disabled { opacity: 0.5; cursor: not-allowed; }
  .status { font-size: 13px; color: var(--ink-2); margin: 0; }

  .progress { padding: clamp(24px, 4vw, 40px) 0; border-top: 1px solid var(--rule); }
  .progress-text {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--ink);
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    padding: 14px 16px;
    max-height: 280px;
    overflow: auto;
    white-space: pre-wrap;
    margin: 0;
  }

  .preview-block, .error-block {
    padding: clamp(24px, 4vw, 40px) 0;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }
  .preview-status { margin: 0; font-size: 14.5px; color: var(--ink-2); }
  #preview-link {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
    border-bottom: 1px solid color-mix(in oklab, var(--accent), transparent 55%);
    text-decoration: none;
  }
  .next-steps { font-size: 13px; color: var(--ink-2); margin: 4px 0 0; }
  .next-steps code { background: var(--paper-2); padding: 2px 6px; border-radius: 3px; }

  .error-block { color: var(--ink); }
  #error-detail {
    font-family: var(--font-mono);
    font-size: 12.5px;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-left: 3px solid #a04c1a;
    border-radius: var(--radius-card);
    padding: 12px 14px;
    margin: 0;
    white-space: pre-wrap;
    max-width: 100%;
    overflow: auto;
  }
</style>

<script define:vars={{ WORKER_URL, NETLIFY_SITE_ID }}>
  // ─── State + element refs ─────────────────────────────────────────
  const form = document.getElementById('edit-form');
  const promptEl = document.getElementById('prompt');
  const dropZone = document.getElementById('drop-zone');
  const fileInput = document.getElementById('file-input');
  const fileListEl = document.getElementById('file-list');
  const submitBtn = document.getElementById('submit-btn');
  const statusEl = document.getElementById('status');
  const progressSection = document.getElementById('progress');
  const progressText = document.getElementById('progress-text');
  const diffViewer = document.getElementById('diff-viewer');
  const diffExplanation = document.getElementById('diff-explanation');
  const diffFiles = document.getElementById('diff-files');
  const fileTemplate = document.getElementById('diff-file-template');
  const editTemplate = document.getElementById('diff-edit-template');
  const previewBlock = document.getElementById('preview-block');
  const previewStatus = document.getElementById('preview-status');
  const previewLink = document.getElementById('preview-link');
  const branchNameEl = document.getElementById('branch-name');
  const errorBlock = document.getElementById('error-block');
  const errorDetail = document.getElementById('error-detail');

  /** @type {File[]} */
  const stagedFiles = [];

  // ─── Image drop ────────────────────────────────────────────────────
  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.setAttribute('data-dragover', 'true');
  });
  dropZone.addEventListener('dragleave', () => dropZone.removeAttribute('data-dragover'));
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.removeAttribute('data-dragover');
    for (const f of e.dataTransfer.files) addFile(f);
  });
  fileInput.addEventListener('change', () => {
    for (const f of fileInput.files) addFile(f);
    fileInput.value = '';
  });

  function addFile(file) {
    if (stagedFiles.length >= 4) {
      statusEl.textContent = 'Up to 4 images per request.';
      return;
    }
    if (file.size > 5_000_000) {
      statusEl.textContent = `${file.name} is over 5MB.`;
      return;
    }
    stagedFiles.push(file);
    renderFileList();
    statusEl.textContent = '';
  }

  function renderFileList() {
    fileListEl.innerHTML = '';
    stagedFiles.forEach((f, i) => {
      const li = document.createElement('li');
      const name = document.createElement('span');
      name.textContent = `${f.name} (${(f.size / 1024).toFixed(0)}KB)`;
      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'remove';
      removeBtn.textContent = 'remove';
      removeBtn.addEventListener('click', () => {
        stagedFiles.splice(i, 1);
        renderFileList();
      });
      li.appendChild(name);
      li.appendChild(removeBtn);
      fileListEl.appendChild(li);
    });
  }

  // ─── Submit + SSE consumption ─────────────────────────────────────
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    diffViewer.hidden = true;
    previewBlock.hidden = true;
    errorBlock.hidden = true;
    diffFiles.innerHTML = '';
    diffExplanation.textContent = '';
    progressSection.hidden = false;
    progressText.textContent = '';
    statusEl.textContent = 'Sending…';

    const fd = new FormData();
    fd.set('prompt', promptEl.value);
    stagedFiles.forEach((f, i) => {
      fd.set(`image-${i}`, f);
      // v1 default: case-study targets need Rannia to specify a slug via
      // her prompt; the drop zone doesn't ask for a slug yet. Route all
      // uploaded images to public/uploads/ for v1.
      fd.set(`target-${i}`, 'public');
    });

    try {
      const res = await fetch(`${WORKER_URL}/edit`, {
        method: 'POST',
        body: fd,
        credentials: 'include',
      });

      if (!res.ok || !res.body) {
        const body = await res.text();
        showError(`Server returned ${res.status}: ${body.slice(0, 500)}`);
        return;
      }

      await consumeSse(res.body);
    } catch (err) {
      showError(err instanceof Error ? err.message : String(err));
    } finally {
      submitBtn.disabled = false;
      statusEl.textContent = '';
    }
  });

  async function consumeSse(stream) {
    const reader = stream.getReader();
    const decoder = new TextDecoder('utf-8');
    let buffer = '';
    while (true) {
      const { value, done } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      let idx;
      while ((idx = buffer.indexOf('\n\n')) !== -1) {
        const chunk = buffer.slice(0, idx);
        buffer = buffer.slice(idx + 2);
        handleSseChunk(chunk);
      }
    }
  }

  function handleSseChunk(chunk) {
    let data = '';
    for (const line of chunk.split('\n')) {
      if (line.startsWith('data:')) data += line.slice(5).trim();
    }
    if (!data) return;
    let evt;
    try { evt = JSON.parse(data); } catch { return; }
    handleEvent(evt);
  }

  function handleEvent(evt) {
    switch (evt.type) {
      case 'stage':
        progressText.textContent += `→ ${evt.stage}${evt.detail ? ' — ' + evt.detail : ''}\n`;
        progressText.scrollTop = progressText.scrollHeight;
        break;
      case 'assistant-text':
        progressText.textContent += evt.text;
        progressText.scrollTop = progressText.scrollHeight;
        break;
      case 'tool-input-delta':
        // Not shown to the user — it's JSON building up. Kept off-screen.
        break;
      case 'usage':
        statusEl.textContent = `in: ${evt.input_tokens} · out: ${evt.output_tokens}`;
        break;
      case 'validation-failure':
        progressText.textContent += `⚠ validation issues (retryable: ${evt.retryable})\n${JSON.stringify(evt.issues, null, 2)}\n`;
        break;
      case 'success':
        renderSuccess(evt);
        break;
      case 'fatal':
        showError(`${evt.code}${evt.detail ? ': ' + evt.detail : ''}`);
        break;
    }
  }

  function renderSuccess(evt) {
    progressSection.hidden = true;
    diffViewer.hidden = false;
    diffExplanation.textContent = evt.explanation;

    for (const file of evt.diff) {
      const node = fileTemplate.content.firstElementChild.cloneNode(true);
      node.querySelector('[data-path]').textContent = file.path;
      const actionBadge = node.querySelector('[data-action-badge]');
      actionBadge.textContent = file.action;
      actionBadge.setAttribute('data-value', file.action);
      if (file.action === 'update' && file.edits) {
        const editsContainer = node.querySelector('[data-edits]');
        file.edits.forEach((edit, idx) => {
          const editNode = editTemplate.content.firstElementChild.cloneNode(true);
          editNode.querySelector('[data-edit-index]').textContent = String(idx + 1);
          editNode.querySelector('[data-old]').textContent = edit.old_str;
          editNode.querySelector('[data-new]').textContent = edit.new_str;
          editsContainer.appendChild(editNode);
        });
      } else if (file.action === 'create' && file.contentPreview) {
        const previewBlock = node.querySelector('[data-create-preview]');
        previewBlock.hidden = false;
        node.querySelector('[data-preview-body]').textContent = file.contentPreview;
      }
      diffFiles.appendChild(node);
    }

    previewBlock.hidden = false;
    branchNameEl.textContent = evt.branch;
    pollNetlifyPreview(evt.branch);
  }

  async function pollNetlifyPreview(branchName) {
    if (!NETLIFY_SITE_ID) {
      previewStatus.textContent = 'Preview URL polling not configured (set PUBLIC_NETLIFY_SITE_ID).';
      return;
    }
    const started = Date.now();
    const cap = 240_000; // 4 min
    while (Date.now() - started < cap) {
      try {
        const res = await fetch(
          `https://api.netlify.com/api/v1/sites/${NETLIFY_SITE_ID}/deploys?branch=${encodeURIComponent(branchName)}`,
          { headers: { Accept: 'application/json' } },
        );
        if (res.ok) {
          const deploys = await res.json();
          const ready = Array.isArray(deploys) && deploys.find((d) => d.state === 'ready');
          if (ready?.deploy_ssl_url ?? ready?.deploy_url) {
            previewStatus.textContent = 'Preview ready.';
            previewLink.href = ready.deploy_ssl_url ?? ready.deploy_url;
            previewLink.hidden = false;
            return;
          }
        }
      } catch { /* transient — keep polling */ }
      await new Promise((r) => setTimeout(r, 6000));
    }
    previewStatus.textContent = 'Preview taking longer than usual. Check Netlify manually.';
  }

  function showError(msg) {
    progressSection.hidden = true;
    errorBlock.hidden = false;
    errorDetail.textContent = msg;
  }
</script>
