---
import BaseLayout from '../layouts/BaseLayout.astro';

// Pagefind ships a self-contained UI (PagefindUI) that mounts into any DOM
// node and does its own input, results rendering, and highlighting. We use
// it here rather than reimplementing search UI. The script + stylesheet
// come from /pagefind/, which the site's postbuild step produces alongside
// the built HTML — see package.json's `search` script (pagefind --site dist).
//
// Pagefind's assets don't exist during `astro dev`, so this page renders
// a fallback message locally and behaves correctly only after `npm run
// build` (or on any Netlify deploy). That's fine — search is a
// production-only concern.
---

<BaseLayout title="Search — Visual Arts" description="Search across case studies, lessons, HSC questions, glossary and practice.">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">Search</p>
      <h1>Find something on the <em>site</em></h1>
      <p class="lede">Across case studies, lessons, glossary, HSC questions, command words, and practice. Try an artist name, a frame, a specific artwork title, or a term.</p>
    </div>

    <div id="search" class="search-mount"></div>

    <noscript>
      <p class="fallback">Search on this site needs JavaScript. Please enable it or navigate via the header menu.</p>
    </noscript>
  </div>
  <div style="height: clamp(48px, 8vw, 96px)"></div>
</BaseLayout>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>

<style>
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 28px); }
  .head { padding: clamp(48px, 8vw, 96px) 0 clamp(24px, 4vw, 40px); border-bottom: 1px solid var(--rule); }
  .eyebrow { font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin: 0 0 18px; }
  h1 { font-family: var(--font-display); font-size: var(--text-display); font-weight: 360; line-height: 1.02; letter-spacing: -0.02em; margin: 0 0 20px; max-width: 22ch; }
  h1 em { color: var(--accent); font-style: italic; font-weight: 340; }
  .lede { font-family: var(--font-display); font-size: var(--text-lede); line-height: 1.4; color: var(--ink); max-width: 60ch; margin: 0; }

  .search-mount { padding: clamp(28px, 4vw, 44px) 0; }
  .fallback { padding: 24px 0; color: var(--ink-2); font-size: 15px; }

  /* Restyle PagefindUI to match the site's editorial palette. Pagefind uses
     CSS custom properties for everything visible, so this is a lightweight
     override rather than a fork. */
  :global(.pagefind-ui) {
    --pagefind-ui-scale: 0.85;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--rule);
    --pagefind-ui-tag: var(--paper-2);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 2px;
    --pagefind-ui-image-border-radius: 2px;
    --pagefind-ui-image-box-ratio: 4 / 3;
    --pagefind-ui-font: var(--font-sans);
  }
  :global(.pagefind-ui__search-input) {
    font-family: var(--font-sans) !important;
    font-size: 16px !important;
    padding: 14px 16px !important;
  }
  :global(.pagefind-ui__result-title) {
    font-family: var(--font-display) !important;
    font-weight: 440 !important;
  }
  :global(.pagefind-ui__result-excerpt) {
    font-family: var(--font-sans) !important;
    color: var(--ink-2) !important;
  }
</style>

<script is:inline>
  // PagefindUI is defined by the plain <script> tag above (loaded from
  // /pagefind/pagefind-ui.js, which the postbuild step produces). Using
  // `is:inline` here keeps this out of Vite's bundler — Vite would
  // otherwise try to resolve the runtime path at build time and fail.
  (function () {
    var mount = document.getElementById('search');
    if (!mount) return;
    if (typeof window.PagefindUI !== 'function') {
      mount.innerHTML =
        '<p style="color:var(--ink-2);font-size:15px;">Search index not available — this page only works after a production build. Rebuild the site and reload.</p>';
      return;
    }
    new window.PagefindUI({
      element: '#search',
      showSubResults: true,
      showImages: false,
      resetStyles: false,
      autofocus: true,
    });
    var q = new URLSearchParams(location.search).get('q');
    if (q) {
      // Give the UI a tick to mount its own DOM, then seed the input.
      setTimeout(function () {
        var input = mount.querySelector('.pagefind-ui__search-input');
        if (input) {
          input.value = q;
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }, 60);
    }
  })();
</script>
