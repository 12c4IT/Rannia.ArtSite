---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Walk every collection that carries a `sources` array, aggregate, dedupe by id.
const [caseStudies, lessons, commandWords, bodyOfWorks] = await Promise.all([
  getCollection('case-studies'),
  getCollection('lessons'),
  getCollection('command-words'),
  getCollection('body-of-works'),
]);

type SourceItem = {
  id: string;
  type: string;
  title: string;
  author: string;
  publisher?: string;
  year: number | string;
  url?: string;
  pages?: string;
  notes?: string;
  usedIn: { label: string; href: string }[];
};

const byId = new Map<string, SourceItem>();

function ingest(sources: any[], label: string, href: string) {
  for (const s of sources) {
    const key = `${s.author}::${s.title}::${s.year}`;
    if (!byId.has(key)) {
      byId.set(key, { ...s, usedIn: [] });
    }
    byId.get(key)!.usedIn.push({ label, href });
  }
}

for (const cs of caseStudies) ingest(cs.data.sources ?? [], cs.data.artist.name, `/case-studies/${cs.id}`);
for (const l of lessons) ingest(l.data.sources ?? [], l.data.title, `/lessons/${l.id}`);
for (const cw of commandWords) ingest(cw.data.sources ?? [], cw.data.term, `/command-words/${cw.data.slug}`);
for (const bow of bodyOfWorks) ingest(bow.data.sources ?? [], bow.data.title, `/body-of-works/${bow.id}`);

const all = [...byId.values()].sort((a, b) => a.author.localeCompare(b.author));

// Group by first letter of author surname.
const authorLetter = (author: string) => {
  const parts = author.split(/\s+/);
  const last = parts[parts.length - 1] ?? author;
  return last.charAt(0).toUpperCase();
};

const byLetter = new Map<string, SourceItem[]>();
for (const s of all) {
  const l = authorLetter(s.author);
  if (!byLetter.has(l)) byLetter.set(l, []);
  byLetter.get(l)!.push(s);
}
const letters = [...byLetter.keys()].sort();
---

<BaseLayout title="References — Visual Arts" description="Master bibliography and image credits — every source cited across the site, deduped and alphabetised.">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">References</p>
      <h1>Every source, <em>cited</em></h1>
      <p class="lede">A master bibliography drawn from every case study, lesson, command word and BOW entry on the site. Deduped and sorted by author surname. Follow the link back to the entry that cites it.</p>
    </div>

    {all.length === 0 && (
      <div class="empty">
        <p class="lab">No cited sources yet</p>
        <p>As content is authored with sources in frontmatter, they aggregate here automatically.</p>
      </div>
    )}

    {all.length > 0 && (
      <>
        <nav class="jump">
          <span class="lab">Jump to</span>
          <ul>
            {letters.map((l) => <li><a href={`#letter-${l}`}>{l}</a></li>)}
          </ul>
        </nav>

        <div class="letters">
          {letters.map((l) => (
            <section class="letter" id={`letter-${l}`}>
              <div class="letter-head">{l}</div>
              <ol class="sources">
                {byLetter.get(l)!.map((s) => (
                  <li>
                    <div class="cite">
                      <b>{s.author}</b>, <em>{s.title}</em>
                      {s.publisher ? `, ${s.publisher}` : ''}
                      {s.year ? ` (${s.year})` : ''}
                      {s.pages ? `, ${s.pages}` : ''}
                      {s.url && <> · <a href={s.url}>link</a></>}
                    </div>
                    {s.notes && <p class="notes">{s.notes}</p>}
                    <div class="used">
                      <span class="ulab">Cited in</span>
                      <ul>
                        {s.usedIn.map((u) => (
                          <li><a href={u.href}>{u.label}</a></li>
                        ))}
                      </ul>
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </>
    )}
  </div>
  <div style="height: clamp(48px, 8vw, 96px)"></div>
</BaseLayout>

<style>
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 28px); }
  .head { padding: clamp(48px, 8vw, 96px) 0 clamp(24px, 4vw, 48px); border-bottom: 1px solid var(--rule); }
  .eyebrow { font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin: 0 0 18px; }
  h1 { font-family: var(--font-display); font-size: var(--text-display); font-weight: 360; line-height: 1.02; letter-spacing: -0.02em; margin: 0 0 20px; max-width: 18ch; }
  h1 em { color: var(--accent); font-style: italic; font-weight: 340; }
  .lede { font-family: var(--font-display); font-size: var(--text-lede); line-height: 1.4; color: var(--ink); max-width: 62ch; margin: 0; }

  .empty { padding: clamp(48px, 8vw, 96px) 0; }
  .empty .lab { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin: 0 0 8px; }
  .empty p:not(.lab) { color: var(--ink-2); margin: 0; }

  .jump { padding: 24px 0; border-bottom: 1px solid var(--rule); display: flex; flex-wrap: wrap; align-items: baseline; gap: 14px 16px; }
  .jump .lab { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-2); margin: 0; }
  .jump ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 4px; }
  .jump a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px;
    font-family: var(--font-mono); font-size: 12px; font-weight: 500;
    color: var(--ink-2); border: 1px solid var(--rule); border-radius: 50%;
    text-decoration: none;
  }
  .jump a:hover { color: var(--accent); border-color: var(--accent); }

  .letters { padding: 20px 0; display: flex; flex-direction: column; gap: clamp(28px, 4vw, 48px); }
  .letter { display: grid; grid-template-columns: 60px 1fr; gap: 20px; scroll-margin-top: 24px; }
  @media (max-width: 720px) { .letter { grid-template-columns: 1fr; gap: 8px; } }
  .letter-head {
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 340;
    color: var(--accent);
    line-height: 1;
    position: sticky;
    top: 20px;
    align-self: start;
    font-style: italic;
  }

  .sources { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 20px; }
  .sources > li { padding: 18px 20px; border: 1px solid var(--rule); border-radius: var(--radius-card); background: var(--paper); }
  .cite { font-size: 14.5px; line-height: 1.6; color: var(--ink); }
  .cite b { font-weight: 500; }
  .cite em { font-style: italic; color: var(--ink); }
  .cite a { color: var(--accent); }
  .notes { font-size: 13.5px; color: var(--ink-2); font-style: italic; margin: 8px 0 0; }

  .used { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--rule); display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .ulab { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-2); }
  .used ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .used a {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-2); border: 1px solid var(--rule); border-radius: 999px; padding: 4px 10px;
    text-decoration: none;
  }
  .used a:hover { color: var(--accent); border-color: var(--accent); }
</style>
