---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ComingSoon from '../components/ui/ComingSoon.astro';

// Review environment — every entry renders. Consent gate applies only when
// we stand up a separate public production site.
const entries = await getCollection('body-of-works');
---

<BaseLayout title="Body of Works — Visual Arts" description="Student BOW examples, indexed by medium, from graduates who agreed to share.">
  {entries.length === 0 ? (
    <ComingSoon
      eyebrow="Student body of works"
      title="What a Band 6 BOW looks like"
      blurb="Selected examples from graduates who agreed to share their work. Each entry will break down concept, materials, frames engaged, practice narrative, why it scored highly, and things you could take into your own BOW."
      waitingOn="Signed consent from students, and Rannia authoring the first examples."
    />
  ) : (
    <div class="wrap">
      <p>Gallery will render {entries.length} entries once Task 7a builds the listing UI.</p>
    </div>
  )}
</BaseLayout>

<style>
  .wrap { max-width: 900px; margin: 0 auto; padding: clamp(48px, 8vw, 96px) clamp(16px, 4vw, 28px); }
</style>
