---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FrameBadge from '../../components/case-study/FrameBadge.astro';

const AREAS = [
  'the-body', 'place', 'identity', 'time', 'memory',
  'objects', 'nature', 'technology', 'spirituality', 'the-everyday', 'other',
] as const;

const all = await getCollection('questions');

// Group by content area. A question can appear under more than one area if
// tagged so.
const byArea = new Map<string, typeof all>();
for (const area of AREAS) byArea.set(area, [] as any);
for (const entry of all) {
  for (const a of entry.data.contentAreas) {
    if (byArea.has(a)) byArea.get(a)!.push(entry);
  }
}
for (const [, list] of byArea) list.sort((a, b) => b.data.year - a.data.year);

const populated = AREAS.filter((a) => (byArea.get(a) ?? []).length > 0);
const empty = AREAS.filter((a) => (byArea.get(a) ?? []).length === 0);

const label = (a: string) =>
  a.split('-').map((w) => (w === 'the' ? 'The' : w.charAt(0).toUpperCase() + w.slice(1))).join(' ');
---

<BaseLayout title="HSC questions — by topic" description="Every past HSC Visual Arts question, grouped by content area.">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">
        <a href="/questions">HSC questions</a>
        <span class="sep">·</span>
        By topic
      </p>
      <h1>Every question, <em>by topic</em></h1>
      <p class="lede">Past HSC questions grouped by content area — the way many students study for a specific topic. Jump to any area, or scan the whole library.</p>
    </div>

    {populated.length === 0 && (
      <div class="empty">
        <p class="lab">No questions yet</p>
        <p>The topic library populates as questions are transcribed from the NESA back-catalogue.</p>
      </div>
    )}

    {populated.length > 0 && (
      <>
        <nav class="jump">
          <span class="lab">Jump to</span>
          <ul>
            {populated.map((a) => (
              <li><a href={`#${a}`}>{label(a)} ({byArea.get(a)!.length})</a></li>
            ))}
          </ul>
        </nav>

        <div class="areas">
          {populated.map((a) => (
            <section class="area" id={a}>
              <header>
                <p class="rlabel">Content area</p>
                <h2>{label(a)}</h2>
                <a class="all-link" href={`/questions/by-content-area/${a}`}>See area page →</a>
              </header>
              <div class="qlist">
                {byArea.get(a)!.map((e) => (
                  <a class="qrow" href={`/questions/${e.id}`}>
                    <span class="tag">{e.data.year} · Q{e.data.questionNumber} · {e.data.marks}m</span>
                    <p class="text">{e.data.text.split('\n')[0]}</p>
                    <div class="badges">
                      {e.data.frames.map((f) => <FrameBadge frame={f as any} />)}
                    </div>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </>
    )}

    {empty.length > 0 && (
      <div class="empty-areas">
        <p class="lab">Areas without questions yet</p>
        <div class="chips">
          {empty.map((a) => <span class="chip">{label(a)}</span>)}
        </div>
      </div>
    )}
  </div>
  <div style="height: clamp(48px, 8vw, 96px)"></div>
</BaseLayout>

<style>
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 28px); }
  .head { padding: clamp(48px, 8vw, 96px) 0 clamp(24px, 4vw, 48px); border-bottom: 1px solid var(--rule); }
  .eyebrow { font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin: 0 0 22px; display: flex; gap: 10px; align-items: center; }
  .eyebrow a { color: var(--accent); text-decoration: none; border-bottom: 1px solid color-mix(in oklab, var(--accent), transparent 60%); }
  .sep { opacity: 0.4; }
  h1 { font-family: var(--font-display); font-size: var(--text-display); font-weight: 360; line-height: 1.02; letter-spacing: -0.02em; margin: 0 0 20px; }
  h1 em { color: var(--accent); font-style: italic; font-weight: 340; }
  .lede { font-family: var(--font-display); font-size: var(--text-lede); line-height: 1.4; color: var(--ink); max-width: 60ch; margin: 0; }

  .empty { padding: clamp(48px, 8vw, 96px) 0; }
  .empty .lab { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin: 0 0 8px; }
  .empty p:not(.lab) { color: var(--ink-2); margin: 0; max-width: 60ch; }

  .jump { padding: 24px 0; border-bottom: 1px solid var(--rule); display: flex; flex-wrap: wrap; align-items: baseline; gap: 16px; }
  .jump .lab { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-2); }
  .jump ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .jump a {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 6px 12px;
    text-decoration: none;
  }
  .jump a:hover { color: var(--accent); border-color: var(--accent); }

  .areas { padding: 20px 0; display: flex; flex-direction: column; gap: clamp(28px, 5vw, 48px); }
  .area { scroll-margin-top: 24px; }
  .area header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 14px; margin-bottom: 16px; }
  .rlabel { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin: 0; }
  .area h2 { font-family: var(--font-display); font-size: 28px; font-weight: 400; margin: 0; letter-spacing: -0.015em; }
  .all-link { margin-left: auto; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); text-decoration: none; }

  .qlist { display: flex; flex-direction: column; border-top: 1px solid var(--rule); }
  .qrow {
    display: grid;
    grid-template-columns: 140px 1fr auto;
    gap: 18px;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    align-items: center;
  }
  .qrow:hover { background: var(--paper-2); }
  @media (max-width: 720px) { .qrow { grid-template-columns: 1fr; gap: 8px; } }
  .tag { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); }
  .text { font-family: var(--font-display); font-size: 16px; line-height: 1.4; color: var(--ink); margin: 0; }
  .badges { display: flex; flex-wrap: wrap; gap: 6px; }

  .empty-areas { padding: clamp(28px, 5vw, 48px) 0 0; border-top: 1px solid var(--rule); margin-top: 20px; }
  .empty-areas .lab { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-2); margin: 0 0 10px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chips .chip {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
    border: 1px dashed var(--rule);
    border-radius: 999px;
    padding: 5px 10px;
  }
</style>
