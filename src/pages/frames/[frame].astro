---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LastReviewed from '../../components/ui/LastReviewed.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';

// This site is currently a review environment — drafts render so Rannia
// can preview her authoring on the Netlify deploy. When we stand up a
// separate public production site, we'll add PUBLIC_HIDE_DRAFTS filtering
// here.
export const getStaticPaths = (async () => {
  const all = await getCollection('pages');
  const frames = ['subjective', 'cultural', 'structural', 'postmodern'] as const;
  return frames
    .map((frame) => {
      const entry = all.find((p) => p.id === `frames/${frame}`);
      return entry ? { params: { frame }, props: { entry } } : null;
    })
    .filter((x): x is NonNullable<typeof x> => x !== null);
}) satisfies GetStaticPaths;

const { frame } = Astro.params;
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} — Visual Arts`} description={entry.data.description}>
  <article>
    <header class="head" data-frame={frame}>
      <div class="wrap">
        <p class="eyebrow">The Frames</p>
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.description}</p>
      </div>
    </header>

    <div class="wrap prose">
      <Content />

      {entry.data.lastReviewed && (
        <LastReviewed date={entry.data.lastReviewed} reviewedBy="Rannia" />
      )}
    </div>
  </article>

  <StatusBadge status={entry.data.status} />
</BaseLayout>

<style>
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 28px); }
  .head { padding: clamp(48px, 8vw, 96px) 0 clamp(24px, 4vw, 48px); border-bottom: 1px solid var(--rule); border-top: 4px solid var(--tone); }
  .head[data-frame="subjective"] { --tone: var(--f-subj); }
  .head[data-frame="cultural"]   { --tone: var(--f-cult); }
  .head[data-frame="structural"] { --tone: var(--f-struct); }
  .head[data-frame="postmodern"] { --tone: var(--f-post); }
  .eyebrow { font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: 0.12em; text-transform: uppercase; color: var(--tone); margin: 0 0 18px; }
  h1 { font-family: var(--font-display); font-size: var(--text-display); font-weight: 360; line-height: 1.0; letter-spacing: -0.02em; margin: 0 0 20px; }
  .lede { font-family: var(--font-display); font-size: var(--text-lede); line-height: 1.4; color: var(--ink); max-width: 60ch; margin: 0; }

  .prose { padding: clamp(40px, 6vw, 72px) 0; max-width: 720px; margin-left: auto; margin-right: auto; }
  .prose :global(h2) { font-family: var(--font-display); font-size: 28px; font-weight: 440; margin: 40px 0 16px; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { font-family: var(--font-display); font-size: 21px; font-weight: 440; margin: 28px 0 10px; }
  .prose :global(p) { font-size: var(--text-body); line-height: 1.72; color: var(--ink); margin: 0 0 20px; }
  .prose :global(ul) { padding-left: 22px; margin: 0 0 20px; }
  .prose :global(li) { font-size: var(--text-body); line-height: 1.7; margin: 6px 0; color: var(--ink); }
  .prose :global(em) { font-style: italic; }
  .prose :global(strong) { font-weight: 500; color: var(--ink); }
  .prose :global(a) { color: var(--accent); }
  .prose :global(blockquote) {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--ink);
    border-left: 3px solid var(--accent);
    padding: 4px 0 4px 20px;
    margin: 28px 0;
  }
</style>
