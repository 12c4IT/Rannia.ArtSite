---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const all = await getCollection('pages');
const frames = ['subjective', 'cultural', 'structural', 'postmodern'] as const;

// Review environment — all frame pages render regardless of status.
const framePages = frames.map((slug) => {
  const entry = all.find((p) => p.id === `frames/${slug}`);
  return { slug, entry: entry ?? null };
});
---

<BaseLayout title="The Frames — Visual Arts" description="Subjective, cultural, structural, postmodern — four lenses for reading art.">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">The Frames</p>
      <h1>Four ways of <em>reading</em> a work</h1>
      <p class="lede">The same artwork yields four different readings through the four frames. Strong HSC responses don't pick one and stop — they move between the frames as the argument demands.</p>
    </div>

    <div class="grid">
      {framePages.map(({ slug, entry }) => (
        <a class="frame-card" data-frame={slug} href={`/frames/${slug}`}>
          <span class="fname">{entry?.data.title ?? `${slug.charAt(0).toUpperCase()}${slug.slice(1)} frame`}</span>
          <p>{entry?.data.description ?? ''}</p>
          <span class="go">Explore →</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 28px); }
  .head { padding: clamp(48px, 8vw, 96px) 0 clamp(24px, 4vw, 48px); border-bottom: 1px solid var(--rule); }
  .eyebrow { font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin: 0 0 18px; }
  h1 { font-family: var(--font-display); font-size: var(--text-display); font-weight: 360; line-height: 1.0; letter-spacing: -0.02em; margin: 0 0 20px; max-width: 14ch; }
  h1 em { color: var(--accent); font-style: italic; font-weight: 340; }
  .lede { font-family: var(--font-display); font-size: var(--text-lede); line-height: 1.4; color: var(--ink); max-width: 54ch; margin: 0; }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    margin: clamp(32px, 5vw, 56px) 0;
  }
  @media (min-width: 560px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .grid { grid-template-columns: repeat(4, 1fr); } }
  .frame-card {
    background: var(--paper);
    padding: 32px 26px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    border-top: 3px solid var(--tone);
    transition: background 140ms ease;
    min-height: 180px;
  }
  .frame-card:hover { background: var(--paper-2); }
  .frame-card[data-frame="subjective"] { --tone: var(--f-subj); }
  .frame-card[data-frame="cultural"]   { --tone: var(--f-cult); }
  .frame-card[data-frame="structural"] { --tone: var(--f-struct); }
  .frame-card[data-frame="postmodern"] { --tone: var(--f-post); }
  .fname { font-family: var(--font-display); font-size: 26px; font-weight: 420; color: var(--ink); }
  .frame-card p { font-size: 14.5px; line-height: 1.55; color: var(--ink-2); margin: 0; }
  .go { margin-top: auto; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--tone); }
</style>
