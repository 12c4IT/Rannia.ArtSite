---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BowCard from '../../../components/bow/BowCard.astro';

type MediumKey =
  | 'painting' | 'drawing' | 'sculpture' | 'ceramics'
  | 'photography' | 'time-based' | 'digital' | 'collection-of-works';

export const getStaticPaths = (async () => {
  const media: MediumKey[] = [
    'painting', 'drawing', 'sculpture', 'ceramics',
    'photography', 'time-based', 'digital', 'collection-of-works',
  ];
  return media.map((medium) => ({ params: { medium } }));
}) satisfies GetStaticPaths;

const { medium } = Astro.params;
const key = medium as MediumKey;

const all = await getCollection('body-of-works');
const entries = all
  .filter((e) => e.data.medium === key && e.data.consent.onFile)
  .sort((a, b) => b.data.yearGraduated - a.data.yearGraduated);

const label = key.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
---

<BaseLayout title={`Body of Works — ${label}`} description={`Student BOW examples in ${label.toLowerCase()}.`}>
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">
        <a href="/body-of-works">Body of Works</a>
        <span class="sep">·</span>
        Medium
      </p>
      <h1><em>{label}</em></h1>
      <p class="lede">Student BOW examples in {label.toLowerCase()}. Every entry has signed consent on file.</p>
    </div>

    {entries.length === 0 && (
      <div class="empty">
        <p class="lab">No {label.toLowerCase()} entries yet</p>
        <p>Once a student's BOW in this medium is authored with signed consent, it appears here.</p>
      </div>
    )}

    {entries.length > 0 && (
      <div class="grid">
        {entries.map((e) => (
          <BowCard
            href={`/body-of-works/${e.id}`}
            title={e.data.title}
            studentDisplayName={e.data.studentDisplayName}
            yearGraduated={e.data.yearGraduated}
            medium={e.data.medium}
            band={e.data.band}
            shortPitch={e.data.shortPitch}
            heroImage={{ src: e.data.heroImage.src, alt: e.data.heroImage.alt }}
            frames={e.data.frames}
          />
        ))}
      </div>
    )}
  </div>
  <div style="height: clamp(48px, 8vw, 96px)"></div>
</BaseLayout>

<style>
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 28px); }
  .head { padding: clamp(48px, 8vw, 96px) 0 clamp(24px, 4vw, 48px); border-bottom: 1px solid var(--rule); }
  .eyebrow { font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin: 0 0 22px; display: flex; gap: 10px; align-items: center; }
  .eyebrow a { color: var(--accent); text-decoration: none; border-bottom: 1px solid color-mix(in oklab, var(--accent), transparent 60%); }
  .sep { opacity: 0.4; }
  h1 { font-family: var(--font-display); font-size: var(--text-display); font-weight: 360; line-height: 1.02; letter-spacing: -0.02em; margin: 0 0 20px; }
  h1 em { color: var(--accent); font-style: italic; font-weight: 340; }
  .lede { font-family: var(--font-display); font-size: var(--text-lede); line-height: 1.4; color: var(--ink); max-width: 60ch; margin: 0; }

  .empty { padding: clamp(48px, 8vw, 96px) 0; max-width: 60ch; }
  .empty .lab { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin: 0 0 8px; }
  .empty p:not(.lab) { color: var(--ink-2); margin: 0; }

  .grid { padding: clamp(28px, 4vw, 44px) 0; display: grid; grid-template-columns: 1fr; gap: 22px; }
  @media (min-width: 620px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 980px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
